# Debian 13 (trixie) build and CI image.
#
# The build host MUST NOT be Debian 12. Its webkit2gtk is end-of-life at
# 2.50.6 (Debian security tracker, DSA-6232-1), so it will never receive the
# WSA-2026-0004 fixes (23 CVEs) nor the WSA-2026-0005 fixes (9 more, among
# them an iframe sandbox violation and use-after-free), all reachable by
# visiting a page. Trixie security carries 2.52.6-1~deb13u1, which is the
# floor `platform::MIN_WEBKITGTK` enforces at runtime.
#
# This is a container rather than a host upgrade on purpose: the machine this
# was developed on runs 19 unrelated pm2 services, and a dist-upgrade to pick
# up a browser dependency would be an absurd blast radius.
FROM debian:13

# trixie-security is where the fixed webkit lives, so it is not optional here.
# Failing loudly at build time is better than silently resolving an older one.
# nodejs is in this same reproducible trixie install because chrome-js-gate
# executes the chrome scripts against a DOM stub; without it the image cannot
# run the suite it was built to run.
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
        build-essential \
        pkg-config \
        curl \
        ca-certificates \
        git \
        nodejs \
        libwebkit2gtk-4.1-dev \
        libgtk-3-dev \
        libssl-dev \
        xvfb \
        xauth \
    && rm -rf /var/lib/apt/lists/*

# Fail the image build if the engine is below the floor, rather than
# discovering it in a test run later. dpkg-query is the build-time mirror of
# the runtime check in enforce_engine_floor().
RUN set -eu; \
    v="$(dpkg-query -W -f='${Version}' libwebkit2gtk-4.1-dev)"; \
    echo "webkit2gtk-4.1-dev = $v"; \
    if dpkg --compare-versions "$v" ge 2.52.6; then \
      echo "at or above the 2.52.6 floor"; \
    else \
      echo "REFUSING: $v is below the 2.52.6 security floor" >&2; exit 1; \
    fi

# Pinned toolchain. rust-toolchain.toml pins the channel, but rustup must
# exist to honour it, and the pin is repeated here so an image built without
# the repo mounted still lands on the right compiler. Repeating a version is
# how it goes stale -- this one sat a release behind the pin once, so "the
# right compiler" meant the wrong one. It is now checked against
# rust-toolchain.toml by scripts/toolchain-pin-gate.sh, which also refuses any
# other version literal in this file, comments included.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --no-modify-path --default-toolchain 1.98.0 \
        -c rustfmt -c clippy \
    && chmod -R a+w "$RUSTUP_HOME" "$CARGO_HOME"

WORKDIR /src
